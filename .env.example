# -----------------------------------------------------------------------------
# Plantilla de variables de entorno del backend de Impulso Tech.
#
# Copie este archivo a `.env` y complete los valores locales o de despliegue.
# El archivo `.env` está ignorado por Git y nunca debe subirse al repositorio.
# -----------------------------------------------------------------------------

# Perfil activo de Spring (dev | prod)
SPRING_PROFILES_ACTIVE=dev

# Base de datos PostgreSQL principal
DATABASE_URL=jdbc:postgresql://localhost:15432/impulso_tech
DATABASE_USERNAME=impulso
DATABASE_PASSWORD=impulso

# Redis (caché, sesiones temporales, rate limiting)
REDIS_URL=redis://localhost:6379

# Servidor
SERVER_PORT=8080

# Correo transaccional (Brevo mediante SMTP)
# Ponga APP_MAIL_ENABLED=true en producción o para pruebas con Brevo.
# En desarrollo local puede dejarse en false para que los enlaces se
# escriban en el log en lugar de enviarse.
APP_MAIL_ENABLED=false
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
# MAIL_USERNAME suele ser el correo de la cuenta Brevo (o el "SMTP login"
# que aparece en el panel de Brevo → SMTP & API).
MAIL_USERNAME=
# MAIL_PASSWORD debe ser la SMTP key generada en Brevo, no la contraseña
# de la cuenta.
MAIL_PASSWORD=
MAIL_SENDER=no-reply@impulso.tech
MAIL_SENDER_NAME=Impulso Tech
# URLs del frontend a las que apuntan los enlaces incluidos en el correo.
MAIL_VERIFICATION_URL=http://localhost:4200/auth/verify
MAIL_PASSWORD_RESET_URL=http://localhost:4200/auth/reset-password

# Seguridad
JWT_SECRET=cambiar-por-un-valor-largo-y-aleatorio
JWT_EXPIRATION_MINUTES=60

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Proveedor de IA
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=

# Primer administrador (utilizado únicamente al arrancar si no existe ninguno)
APP_ADMIN_EMAIL=admin@impulso.tech
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=cambiar-en-produccion-1
APP_ADMIN_FIRST_NAME=Admin
APP_ADMIN_LAST_NAME=Impulso
